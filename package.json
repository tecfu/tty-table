{
  "name": "tty-table",
  "version": "6.0.0",
  "description": "Typed terminal table renderer for Node.js and browsers",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "browser": "dist/browser/tty-table.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "engines": { "node": ">=20" },
  "bin": { "tty-table": "dist/cli.cjs" },
  "files": ["dist/", "README.md", "LICENSE.txt"],
  "scripts": {
    "build": "tsup && tsup --config tsup.browser.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "repository": { "type": "git", "url": "https://github.com/tecfu/tty-table.git" },
  "keywords": ["table", "cli-table", "terminal table", "console table", "ascii table"],
  "author": "Tecfu",
  "license": "MIT",
  "bugs": { "url": "https://github.com/tecfu/tty-table/issues" },
  "homepage": "https://github.com/tecfu/tty-table",
  "dependencies": {
    "csv": "^6.3.11",
    "wcwidth": "^1.0.1",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@types/node": "^22.15.0",
    "@types/wcwidth": "^1.0.2",
    "eslint": "^9.30.0",
    "typescript-eslint": "^8.35.0",
    "typescript": "^5.8.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4"
  }
}
